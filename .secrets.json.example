{
  "_notes": {
    "_": "Copy this file to '.secrets.json' (without the .example) and fill in the blocks you use. Each block is only needed by the commands that use it. The .secrets.json file is gitignored — never commit it.",
    "tmdb": "Needed by validate:movies / validate:shows. Get a free API v3 key from https://developer.themoviedb.org/docs/getting-started.",
    "plex": "Needed by the plex:* commands. In Plex Web open any item → ⋯ → Get Info → View XML; the token is the X-Plex-Token value at the end of the page URL. Pair it with plex.url in config.json. See docs/PLEX.md."
  },
  "tmdb": {
    "api_key": "PASTE-YOUR-TMDB-V3-API-KEY-HERE"
  },
  "plex": {
    "token": "PASTE-YOUR-PLEX-TOKEN-HERE"
  }
}

{
  "name": "moasys-vault",
  "version": "1.0.0",
  "description": "MOASYS-Vault — Plex Media Library Scanner",
  "scripts": {
    "movies": "tsx src/scan.ts --type movies",
    "shows": "tsx src/scan.ts --type shows",
    "music": "tsx src/scan.ts --type music",
    "audiobooks": "tsx src/scan.ts --type audiobooks",
    "scan:all": "tsx src/scan.ts --all",
    "validate:movies": "tsx src/validate/runner.ts --type movies",
    "validate:shows": "tsx src/validate/runner.ts --type shows",
    "validate:audiobooks": "tsx src/validate/runner.ts --type audiobooks",
    "validate:all": "tsx src/validate/runner.ts --all",
    "plex:pull": "tsx src/plex/pull.ts",
    "plex:check": "tsx src/plex/check.ts --all",
    "fix:shows": "tsx src/tools/rename-shows.ts",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "lint:md": "markdownlint-cli2 **/*.md #node_modules",
    "prettier:fix": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"**/*.md\" \"!node_modules\"",
    "prettier": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"**/*.md\" \"!node_modules\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^8.57.0",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.2.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "ffprobe-static": "^3.1.0",
    "js-yaml": "^4.1.1",
    "music-metadata": "^11.12.3",
    "zod": "^4.4.3"
  }
}

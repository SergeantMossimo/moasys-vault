{
  "name": "moasys-vault",
  "version": "0.14.0",
  "description": "MOASYS-Vault — Plex Media Library Scanner",
  "scripts": {
    "movies": "tsx src/scan.ts --type movies",
    "shows": "tsx src/scan.ts --type shows",
    "music": "tsx src/scan.ts --type music",
    "audiobooks": "tsx src/scan.ts --type audiobooks",
    "all": "tsx src/run-all.ts",
    "scan:all": "tsx src/scan.ts --all",
    "validate:movies": "tsx src/validate/runner.ts --type movies",
    "validate:shows": "tsx src/validate/runner.ts --type shows",
    "validate:audiobooks": "tsx src/validate/runner.ts --type audiobooks",
    "validate:all": "tsx src/validate/runner.ts --all",
    "plex:pull": "tsx src/plex/pull.ts",
    "plex:check": "tsx src/plex/check.ts --all",
    "plex:logs": "tsx src/plex/logs.ts --all",
    "fix:shows": "tsx src/tools/rename-shows.ts",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "prettier:fix": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"**/*.md\" \"!node_modules\"",
    "prettier": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"**/*.md\" \"!node_modules\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test && npm run prettier && npm run lint:md"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "smol-toml": "^1.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "ffprobe-static": "^3.1.0",
    "js-yaml": "^4.3.2",
    "music-metadata": "^11.15.0",
    "zod": "^4.6.5"
  }
}

# ─────────────────────────────────────────────
# MOASYS-Vault .gitignore
# ─────────────────────────────────────────────

# Generated locally from your media library — never committed.
output/

# File inspection cache. Always rebuildable, never committed.
cache/

# Personal rule overrides — gitignored so library-specific values
# (categories, quality_thresholds, ignored_season_names) stay out of the repo.
# The committed `rules/<type>.yaml` files are the shipped defaults.
rules/*.local.yaml

# Per-user ignore lists, one folder per drive (ignored/<drive>/<type>.yaml).
# The committed top-level `.yaml.example` templates stay in. `.bak` covers the
# backups left behind when an ignore list is converted to a new format.
ignored/**/*.yaml
ignored/**/*.bak
!ignored/*.yaml.example

# Per-machine library paths and Plex address. Copy config.example.json to
# config.json and edit it; the example is what's committed.
config.json

# Secrets — TMDB API key etc. NEVER commit this.
.secrets.json

# TypeScript build output
dist/

# Test coverage report (npm run test:coverage)
coverage/

# Node modules
node_modules/

# Tool caches
.prettier-cache
.eslintcache

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/

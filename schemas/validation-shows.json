{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moasys.local/vault/schemas/validation-shows.json",
  "title": "MOASYS-Vault — validation.json (shows)",
  "description": "Per-show TMDB validation results, joinable to shows.json by (title, year, edition). Each show carries per-season validation (episode counts compared to TMDB). Generated by `npm run validate:shows`.",
  "type": "array",
  "items": { "$ref": "#/$defs/ShowValidation" },
  "$defs": {
    "ShowValidation": {
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "year": { "type": "integer" },
        "edition": {
          "type": ["string", "null"],
          "description": "Plex TV Show Editions tag off the show folder, or null when untagged. Two editions of one series share a TMDB match but are separate rows."
        },
        "confidence": { "type": "string", "enum": ["high", "medium", "low", "none"] },
        "tmdb_id": { "type": ["integer", "null"] },
        "tmdb_title": { "type": ["string", "null"] },
        "tmdb_title_filename_safe": {
          "type": ["string", "null"],
          "description": "TMDB title with filename-illegal characters stripped. Use as a rename target."
        },
        "tmdb_first_air_year": { "type": ["integer", "null"] },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "integer" },
              "title": { "type": "string" },
              "year": { "type": ["integer", "null"] }
            },
            "required": ["id", "title", "year"],
            "additionalProperties": false
          }
        },
        "seasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/SeasonValidation" }
        }
      },
      "required": [
        "title",
        "year",
        "edition",
        "confidence",
        "tmdb_id",
        "tmdb_title",
        "tmdb_title_filename_safe",
        "tmdb_first_air_year",
        "alternatives",
        "seasons"
      ],
      "additionalProperties": false
    },
    "SeasonValidation": {
      "type": "object",
      "properties": {
        "season": {
          "type": "string",
          "description": "Season label from scan ('1', '2', 'Specials')."
        },
        "local_episode_count": { "type": "integer", "minimum": 0 },
        "tmdb_episode_count": {
          "type": ["integer", "null"],
          "description": "Episodes TMDB reports for this season, or null when the season isn't in TMDB."
        },
        "missing": {
          "type": ["integer", "null"],
          "description": "tmdb_episode_count − local_episode_count when both known. Positive = you're missing episodes; negative = you have extras."
        }
      },
      "required": ["season", "local_episode_count", "tmdb_episode_count", "missing"],
      "additionalProperties": false
    }
  }
}

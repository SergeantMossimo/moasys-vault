{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moasys.local/vault/schemas/music.json",
  "title": "MOASYS-Vault — music.json",
  "description": "The music catalog. One entry per artist; each artist carries its albums. Album release year is NOT in the catalog — see data/probe.json's track tags. Generated by `npm run music`.",
  "type": "array",
  "items": { "$ref": "#/$defs/ArtistOutput" },
  "$defs": {
    "ArtistOutput": {
      "type": "object",
      "properties": {
        "artist": {
          "type": "string",
          "minLength": 1,
          "description": "Artist folder name as-is. Use the literal 'Various Artists' for multi-artist compilations per Plex convention."
        },
        "albums": {
          "type": "array",
          "items": { "$ref": "#/$defs/AlbumOutput" }
        }
      },
      "required": ["artist", "albums"],
      "additionalProperties": false
    },
    "AlbumOutput": {
      "type": "object",
      "properties": {
        "album": { "type": "string", "minLength": 1 },
        "track_count": { "type": "integer", "minimum": 0 },
        "versions": {
          "type": "array",
          "items": { "$ref": "common.json#/$defs/Version" },
          "minItems": 1
        }
      },
      "required": ["album", "track_count", "versions"],
      "additionalProperties": false
    }
  }
}

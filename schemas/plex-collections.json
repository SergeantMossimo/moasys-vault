{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moasys.local/vault/schemas/plex-collections.json",
  "title": "MOASYS-Vault — output/plex/<library>/collections.json",
  "description": "Every collection in one Plex library and the items in it. Generated by `npm run plex:pull`.",
  "type": "object",
  "properties": {
    "generated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp of when this library was pulled."
    },
    "library": {
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" }
      },
      "required": ["key", "title", "slug"],
      "additionalProperties": false
    },
    "collections": {
      "type": "array",
      "items": { "$ref": "#/$defs/Collection" }
    }
  },
  "required": ["generated", "library", "collections"],
  "additionalProperties": false,
  "$defs": {
    "Collection": {
      "type": "object",
      "properties": {
        "rating_key": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "subtype": {
          "type": ["string", "null"],
          "description": "What the collection holds: movie, show, artist, or album."
        },
        "smart": {
          "type": "boolean",
          "description": "True for a rule-based smart collection."
        },
        "item_count": { "type": "integer", "minimum": 0 },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rating_key": {
                "type": "string",
                "description": "Joins to the item with this rating_key in the library's catalog.json."
              },
              "type": { "type": "string" },
              "title": { "type": "string" },
              "year": { "type": ["integer", "null"] }
            },
            "required": ["rating_key", "type", "title", "year"],
            "additionalProperties": false
          }
        }
      },
      "required": ["rating_key", "title", "subtype", "smart", "item_count", "items"],
      "additionalProperties": false
    }
  }
}
